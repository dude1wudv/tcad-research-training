; Environment qualification only: idealized 2D silicon PN diode, dimensions in um.
(sde:clear)
(sdegeo:create-rectangle (position 0 0 0) (position 1 1 0) "Silicon" "P")
(sdegeo:create-rectangle (position 1 0 0) (position 2 1 0) "Silicon" "N")
(sdegeo:define-contact-set "anode" 4 (color:rgb 1 0 0) "##")
(sdegeo:set-current-contact-set "anode")
(sdegeo:define-2d-contact (find-edge-id (position 0 0.5 0)) "anode")
(sdegeo:define-contact-set "cathode" 4 (color:rgb 0 0 1) "##")
(sdegeo:set-current-contact-set "cathode")
(sdegeo:define-2d-contact (find-edge-id (position 2 0.5 0)) "cathode")
(sdedr:define-constant-profile "P_doping" "BoronActiveConcentration" 5e16)
(sdedr:define-constant-profile-region "P_place" "P_doping" "P")
(sdedr:define-constant-profile "N_doping" "PhosphorusActiveConcentration" 1e16)
(sdedr:define-constant-profile-region "N_place" "N_doping" "N")
(sdedr:define-refeval-window "Device" "Rectangle" (position 0 0 0) (position 2 1 0))
(sdedr:define-refinement-size "Mesh" 0.10 0.10 0.01 0.01)
(sdedr:define-refinement-function "Mesh" "DopingConcentration" "MaxTransDiff" 1)
(sdedr:define-refinement-placement "Mesh_place" "Mesh" "Device")
(sde:build-mesh "snmesh" "" "diode")
