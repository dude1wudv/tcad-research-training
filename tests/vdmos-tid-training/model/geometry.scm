; Two-dimensional VDMOS half-cell. Coordinates in um; training, not calibrated.
(sde:clear)
(sdegeo:set-default-boolean "ABA")
(define mesh-scale @MESH_SCALE@)
(sdegeo:create-rectangle (position 0 0 0) (position 5 12 0) "Silicon" "R.Silicon")
(sdegeo:create-rectangle (position 1.5 -0.05 0) (position 5 0 0) "Oxide" "R.GateOxide")
(sdegeo:define-contact-set "source" 4 (color:rgb 1 0 0) "##")
(sdegeo:define-contact-set "drain" 4 (color:rgb 0 0 1) "##")
(sdegeo:define-contact-set "gate" 4 (color:rgb 0 1 0) "##")
(sdegeo:set-contact (find-edge-id (position 0.5 0 0)) "source")
(sdegeo:set-contact (find-edge-id (position 2.5 12 0)) "drain")
(sdegeo:set-contact (find-edge-id (position 3 -0.05 0)) "gate")
(sdedr:define-constant-profile "N.Drift" "PhosphorusActiveConcentration" 5e15)
(sdedr:define-constant-profile-region "Place.Drift" "N.Drift" "R.Silicon")
(sdedr:define-refeval-window "Win.Drain" "Rectangle" (position 0 11 0) (position 5 12 0))
(sdedr:define-constant-profile "N.Drain" "ArsenicActiveConcentration" 1e19)
(sdedr:define-constant-profile-placement "Place.Drain" "N.Drain" "Win.Drain")
(sdedr:define-refeval-window "Base.Body" "Line" (position 0 0 0) (position 2 0 0))
(sdedr:define-gaussian-profile "P.Body" "BoronActiveConcentration" "PeakPos" 0 "PeakVal" 3e17 "ValueAtDepth" 5e15 "Depth" 1.5 "Gauss" "Factor" 0.6)
(sdedr:define-analytical-profile-placement "Place.Body" "P.Body" "Base.Body" "Positive" "NoReplace" "Eval")
(sdedr:define-refeval-window "Base.Source" "Line" (position 0.4 0 0) (position 1.4 0 0))
(sdedr:define-gaussian-profile "N.Source" "ArsenicActiveConcentration" "PeakPos" 0 "PeakVal" 1e20 "ValueAtDepth" 1e17 "Depth" 0.25 "Gauss" "Factor" 0.5)
(sdedr:define-analytical-profile-placement "Place.Source" "N.Source" "Base.Source" "Positive" "NoReplace" "Eval")
(sdedr:define-refeval-window "Win.BodyContact" "Rectangle" (position 0 0 0) (position 0.3 0.3 0))
(sdedr:define-constant-profile "P.Contact" "BoronActiveConcentration" 1e20)
(sdedr:define-constant-profile-placement "Place.BodyContact" "P.Contact" "Win.BodyContact")
(sdedr:define-refeval-window "Win.All" "Rectangle" (position 0 -0.05 0) (position 5 12 0))
(sdedr:define-refinement-size "Mesh.All" (* 0.5 mesh-scale) (* 0.5 mesh-scale) (* 0.02 mesh-scale) (* 0.02 mesh-scale))
(sdedr:define-refinement-function "Mesh.All" "DopingConcentration" "MaxTransDiff" 1)
(sdedr:define-refinement-function "Mesh.All" "MaxLenInt" "Silicon" "Oxide" (* 0.005 mesh-scale) 1.5 "DoubleSide")
(sdedr:define-refinement-placement "Place.All" "Mesh.All" "Win.All")
(sdedr:define-refeval-window "Win.Surface" "Rectangle" (position 0 0 0) (position 5 0.25 0))
(sdedr:define-refinement-size "Mesh.Surface" (* 0.08 mesh-scale) (* 0.015 mesh-scale) (* 0.01 mesh-scale) (* 0.003 mesh-scale))
(sdedr:define-refinement-placement "Place.Surface" "Mesh.Surface" "Win.Surface")
(sdedr:define-refeval-window "Win.Body" "Rectangle" (position 0 0.2 0) (position 3.2 2.2 0))
(sdedr:define-refinement-size "Mesh.Body" (* 0.12 mesh-scale) (* 0.12 mesh-scale) (* 0.015 mesh-scale) (* 0.015 mesh-scale))
(sdedr:define-refinement-placement "Place.BodyMesh" "Mesh.Body" "Win.Body")
(sde:build-mesh "snmesh" "" "vdmos")
